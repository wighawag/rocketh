{
	"name": "@rocketh/signer",
	"version": "0.19.14",
	"description": "Attach private-key and mnemonic signers to rocketh deploy scripts.",
	"keywords": [
		"rocketh",
		"ethereum",
		"evm",
		"solidity",
		"smart-contracts",
		"deployment",
		"signer",
		"private-key",
		"mnemonic"
	],
	"author": "Ronan Sandford",
	"license": "MIT",
	"homepage": "https://github.com/wighawag/rocketh/blob/main/packages/rocketh-signer/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/rocketh.git",
		"directory": "packages/rocketh-signer"
	},
	"bugs": {
		"url": "https://github.com/wighawag/rocketh/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@rocketh/core": "workspace:*",
		"eip-1193": "^0.6.5",
		"eip-1193-signer": "^0.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"as-soon": "^0.1.6",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"prepublishOnly": "cp ../../LICENSE LICENSE",
		"build": "tsc --project tsconfig.build.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest"
	}
}
