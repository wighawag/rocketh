{
	"name": "@rocketh/doc",
	"version": "0.19.23",
	"description": "Generate documentation from EVM contract deployments and NatSpec comments.",
	"keywords": [
		"rocketh",
		"ethereum",
		"evm",
		"solidity",
		"smart-contracts",
		"deployment",
		"documentation",
		"natspec",
		"docgen"
	],
	"author": "Ronan Sandford",
	"license": "MIT",
	"homepage": "https://github.com/wighawag/rocketh/blob/main/packages/rocketh-doc/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/rocketh.git",
		"directory": "packages/rocketh-doc"
	},
	"bugs": {
		"url": "https://github.com/wighawag/rocketh/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"bin": {
		"rocketh-doc": "dist/cli.js"
	},
	"files": [
		"dist",
		"public",
		"src"
	],
	"dependencies": {
		"@rocketh/core": "workspace:*",
		"@types/fs-extra": "^11.0.4",
		"abitype": "^1.3.0",
		"commander": "^15.0.0",
		"fs-extra": "^11.4.0",
		"handlebars": "^4.7.9",
		"viem": "^2.55.13"
	},
	"devDependencies": {
		"@rocketh/node": "workspace:*",
		"@types/node": "^26.2.0",
		"as-soon": "^0.1.6",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@rocketh/node": "workspace:^"
	},
	"scripts": {
		"prepublishOnly": "cp ../../LICENSE LICENSE",
		"build": "tsc --project tsconfig.build.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest"
	}
}
